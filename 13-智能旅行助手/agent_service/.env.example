# ===== Agent 层环境变量样例 =====
# 复制为 .env 后填写。未配置 Key 时自动走 mock 数据，整条链路仍可跑通。

# LLM（OpenAI 兼容接口）。LLM_API_KEY 为空 → 自动使用 MockProvider
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# 强制使用 mock（即使配置了 Key）。本地演示建议 true
LLM_MOCK=true

# 高德地图 Key。为空 → 景点/天气/酒店使用内置北京等城市样例数据
AMAP_API_KEY=

# Java ↔ Python 内部鉴权
INTERNAL_TOKEN=dev-internal-token
